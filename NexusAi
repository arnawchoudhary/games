    <!-- JAVASCRIPT LOGIC -->
    <script>
        /* -------------------------------------------------------------
           1. SUPABASE CREDENTIALS & INITIAL CONFIG
           ------------------------------------------------------------- */
        const SUPABASE_PROJECT_URL = "YOUR_SUPABASE_PROJECT_URL";
        const SUPABASE_ANON_KEY = "YOUR_SUPABASE_PUBLISHABLE_KEY";
        const CUSTOM_BACKEND_ENDPOINT = ""; // Optional backend endpoint

        let supabase = null;
        let currentUser = null;
        let currentSession = null;
        let authMode = "login"; // 'login' or 'signup'
        let requestCounter = 0;
        let isGenerating = false;
        let currentThemeSetting = "dark";

        const $ = id => document.getElementById(id);

        /* -------------------------------------------------------------
           2. THEME SYSTEM (DARK & LIGHT FEATURE)
           ------------------------------------------------------------- */
        const themeIcons = {
            dark: `<svg class="svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>`,
            light: `<svg class="svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg>`
        };

        function getPreferredTheme() {
            const saved = localStorage.getItem("nexus-theme");
            if (saved && (saved === "light" || saved === "dark" || saved === "auto")) {
                return saved;
            }
            return "dark"; // Default fallback
        }

        function resolveThemeMode(pref) {
            if (pref === "auto") {
                return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
            }
            return pref;
        }

        function setTheme(themePref) {
            currentThemeSetting = themePref;
            localStorage.setItem("nexus-theme", themePref);

            const activeTheme = resolveThemeMode(themePref);
            document.documentElement.setAttribute("data-theme", activeTheme);
            
            // Meta theme color update
            const metaTheme = document.querySelector('meta[name="theme-color"]');
            if (metaTheme) {
                metaTheme.setAttribute("content", activeTheme === "dark" ? "#07090e" : "#f7f9fc");
            }

            // Update toggle buttons icon (showing opposite or current)
            const iconSvg = activeTheme === "dark" ? themeIcons.light : themeIcons.dark;
            if ($("authThemeToggle")) $("authThemeToggle").innerHTML = iconSvg;
            if ($("appThemeToggle")) $("appThemeToggle").innerHTML = iconSvg;

            // Update Settings pills
            ["Dark", "Light", "Auto"].forEach(label => {
                const pill = $("themePill" + label);
                if (pill) {
                    pill.classList.toggle("active", themePref === label.toLowerCase());
                }
            });
        }

        function toggleThemeQuick() {
            const currentEffective = resolveThemeMode(currentThemeSetting);
            const next = currentEffective === "dark" ? "light" : "dark";
            setTheme(next);
            showToast(`Theme switched to ${next} mode`, "info");
        }

        // Attach listeners for theme toggling
        if ($("authThemeToggle")) $("authThemeToggle").addEventListener("click", toggleThemeQuick);
        if ($("appThemeToggle")) $("appThemeToggle").addEventListener("click", toggleThemeQuick);

        // Listen for OS system theme changes
        window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
            if (currentThemeSetting === "auto") {
                setTheme("auto");
            }
        });

        /* -------------------------------------------------------------
           3. TOAST NOTIFICATION SYSTEM
           ------------------------------------------------------------- */
        let toastTimeout;
        function showToast(message, type = "info") {
            const toast = $("toastNotification");
            const toastMsg = $("toastMessage");
            const toastIcon = $("toastIcon");

            toast.className = `toast-popup ${type} visible`;
            toastMsg.textContent = message;

            if (type === "success") {
                toastIcon.innerHTML = `<svg class="svg-icon" style="color:var(--success)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>`;
            } else if (type === "error") {
                toastIcon.innerHTML = `<svg class="svg-icon" style="color:var(--danger)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>`;
            } else {
                toastIcon.innerHTML = `<svg class="svg-icon" style="color:var(--accent)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>`;
            }

            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.remove("visible");
            }, 3600);
        }

        /* -------------------------------------------------------------
           4. AUTHENTICATION & DEMO MODE
           ------------------------------------------------------------- */
        function isSupabaseConfigured() {
            return SUPABASE_PROJECT_URL && 
                   SUPABASE_PROJECT_URL.startsWith("https://") &&
                   SUPABASE_PROJECT_URL.includes(".supabase.co") &&
                   SUPABASE_ANON_KEY &&
                   !SUPABASE_PROJECT_URL.includes("YOUR_") &&
                   !SUPABASE_ANON_KEY.includes("YOUR_");
        }

        function setAuthFeedback(msg, type = "error") {
            const box = $("authFeedback");
            box.textContent = msg;
            box.className = `auth-feedback ${type}`;
        }

        function switchAuthMode(mode) {
            authMode = mode;
            setAuthFeedback("");

            const isSignup = mode === "signup";
            $("authTitle").textContent = isSignup ? "Create your account" : "Welcome back";
            $("authSubtitle").textContent = isSignup ? "Start building with Nexus AI today." : "Sign in to your Nexus workspace.";
            $("nameFieldGroup").classList.toggle("hidden", !isSignup);
            $("authSubmitText").textContent = isSignup ? "Create Account" : "Sign In";
            $("switchPrompt").textContent = isSignup ? "Already have an account?" : "Don't have an account?";
            $("switchModeBtn").textContent = isSignup ? "Sign in" : "Create account";
        }

        $("switchModeBtn").addEventListener("click", () => {
            switchAuthMode(authMode === "login" ? "signup" : "login");
        });

        // Demo Mode / Guest Sign-In
        $("guestLoginBtn").addEventListener("click", () => {
            const demoUser = {
                id: "guest-arnaw-id",
                email: "arnaw@studio.local",
                user_metadata: { full_name: "Arnaw (Guest)" }
            };
            enterApplicationSession({ user: demoUser, access_token: "demo-jwt-token" });
            showToast("Logged in as Guest in Demo Mode", "success");
        });

        // Main Auth Form Submit
        $("authForm").addEventListener("submit", async (e) => {
            e.preventDefault();

            if (!isSupabaseConfigured() || !supabase) {
                setAuthFeedback("Notice: Real Supabase keys aren't added yet. Click 'Explore in Demo Mode' below to test the full interface immediately!", "error");
                return;
            }

            const email = $("email").value.trim();
            const password = $("password").value;
            const fullName = $("fullName").value.trim();
            const submitBtn = $("authSubmitBtn");

            if (authMode === "signup" && !fullName) {
                setAuthFeedback("Please enter your name.");
                return;
            }

            submitBtn.disabled = true;
            $("authSubmitText").textContent = "Authenticating...";

            try {
                if (authMode === "signup") {
                    const { data, error } = await supabase.auth.signUp({
                        email,
                        password,
                        options: { data: { full_name: fullName } }
                    });
                    if (error) throw error;
                    if (data.session) {
                        enterApplicationSession(data.session);
                    } else {
                        setAuthFeedback("Verification email sent! Check your inbox to verify your account.", "success");
                    }
                } else {
                    const { data, error } = await supabase.auth.signInWithPassword({ email, password });
                    if (error) throw error;
                    enterApplicationSession(data.session);
                }
            } catch (err) {
                setAuthFeedback(err.message || "Authentication failed. Check your credentials.");
            } finally {
                submitBtn.disabled = false;
                $("authSubmitText").textContent = authMode === "signup" ? "Create Account" : "Sign In";
            }
        });

        // Password Recovery
        $("forgotPasswordBtn").addEventListener("click", async () => {
            const email = $("email").value.trim();
            if (!email) {
                setAuthFeedback("Enter your email address to receive recovery instructions.");
                return;
            }
            if (!isSupabaseConfigured() || !supabase) {
                setAuthFeedback("Password reset requires configured Supabase credentials.");
                return;
            }
            try {
                const { error } = await supabase.auth.resetPasswordForEmail(email);
                if (error) throw error;
                setAuthFeedback("Password reset email sent! Check your inbox.", "success");
            } catch (err) {
                setAuthFeedback(err.message);
            }
        });

        function enterApplicationSession(session) {
            currentSession = session;
            currentUser = session.user;

            const name = (currentUser.user_metadata && currentUser.user_metadata.full_name) 
                         ? currentUser.user_metadata.full_name 
                         : (currentUser.email ? currentUser.email.split("@")[0] : "Arnaw");

            // Update interface labels
            $("sidebarUserName").textContent = name;
            $("sidebarAvatar").textContent = name.charAt(0).toUpperCase();
            $("settingDisplayName").textContent = name;
            $("settingDisplayEmail").textContent = currentUser.email || "arnaw@studio.local";

            $("authScreen").style.display = "none";
            $("application").style.display = "block";
            switchPage("overview");
        }

        async function signOutUser() {
            if (supabase && currentSession && currentSession.access_token !== "demo-jwt-token") {
                await supabase.auth.signOut().catch(() => {});
            }
            currentSession = null;
            currentUser = null;
            $("application").style.display = "none";
            $("authScreen").style.display = "flex";
            $("password").value = "";
            showToast("You have been signed out.", "info");
        }

        $("sidebarLogoutBtn").addEventListener("click", signOutUser);

        /* -------------------------------------------------------------
           5. PAGE NAVIGATION & MOBILE SIDEBAR
           ------------------------------------------------------------- */
        const pageTitles = {
            overview: "Overview",
            chat: "AI Workspace",
            models: "AI Models",
            api: "API Platform",
            settings: "Settings"
        };

        function switchPage(pageId) {
            if (!pageTitles[pageId]) return;

            // Toggle active classes on pages
            document.querySelectorAll(".page-view").forEach(page => {
                page.classList.toggle("active", page.id === pageId);
            });

            // Toggle active classes on nav links
            document.querySelectorAll(".nav-link").forEach(link => {
                link.classList.toggle("active", link.dataset.page === pageId);
            });

            // Update topbar breadcrumb
            $("currentBreadcrumb").textContent = pageTitles[pageId];

            // Close mobile menu if open
            closeMobileMenu();

            // Scroll to top of content
            window.scrollTo({ top: 0, behavior: "smooth" });
        }

        document.querySelectorAll(".nav-link").forEach(btn => {
            btn.addEventListener("click", () => switchPage(btn.dataset.page));
        });

        function openMobileMenu() {
            $("sidebar").classList.add("open");
            $("sidebarBackdrop").classList.add("open");
        }

        function closeMobileMenu() {
            $("sidebar").classList.remove("open");
            $("sidebarBackdrop").classList.remove("open");
        }

        $("mobileMenuBtn").addEventListener("click", openMobileMenu);
        $("sidebarBackdrop").addEventListener("click", closeMobileMenu);

        /* -------------------------------------------------------------
           6. AI CHAT WORKSPACE & STREAMING SIMULATION
           ------------------------------------------------------------- */
        function applySamplePrompt(promptText) {
            $("chatTextarea").value = promptText;
            $("chatTextarea").focus();
            // Automatically trigger send
            $("chatForm").requestSubmit();
        }

        $("clearChatBtn").addEventListener("click", () => {
            const stream = $("chatStream");
            stream.innerHTML = `
                <div class="empty-chat-state" id="emptyChatPlaceholder">
                    <div class="empty-state-icon">
                        <svg class="svg-icon" style="width:32px;height:32px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/>
                        </svg>
                    </div>
                    <h2>How can Nexus assist you today?</h2>
                    <p>Select a quick prompt or enter your query to begin generating solutions.</p>
                    <div class="prompt-chips-grid">
                        <button class="prompt-chip" onclick="applySamplePrompt('Design a high-scale microservices architecture with Redis cache and PostgreSQL.')">
                            <strong>System Architecture</strong>
                            Design microservices with Redis cache
                        </button>
                        <button class="prompt-chip" onclick="applySamplePrompt('Write a clean TypeScript utility for asynchronous rate-limiting and retry logic.')">
                            <strong>TypeScript Logic</strong>
                            Rate-limiting & retry utility
                        </button>
                        <button class="prompt-chip" onclick="applySamplePrompt('Draft a polished product announcement email for Nexus AI by Arnaw Studio.')">
                            <strong>Launch Copy</strong>
                            Nexus AI launch announcement
                        </button>
                        <button class="prompt-chip" onclick="applySamplePrompt('Explain the key differences between transformer self-attention and state-space models.')">
                            <strong>AI Research</strong>
                            Transformers vs SSM architectures
                        </button>
                    </div>
                </div>
            `;
            showToast("Conversation cleared", "info");
        });

        function appendMessage(role, text) {
            const placeholder = $("emptyChatPlaceholder");
            if (placeholder) placeholder.remove();

            const stream = $("chatStream");
            const row = document.createElement("div");
            row.className = `chat-bubble-row ${role}`;

            const avatar = document.createElement("div");
            avatar.className = "bubble-avatar";
            avatar.textContent = role === "user" ? "You" : "N";

            const wrap = document.createElement("div");
            wrap.className = "bubble-content-wrap";

            const author = document.createElement("div");
            author.className = "bubble-author-name";
            author.textContent = role === "user" ? "You" : "Nexus AI";

            const box = document.createElement("div");
            box.className = "bubble-message-box";
            
            // Format basic code block or line breaks
            box.innerHTML = formatMarkdown(text);

            wrap.append(author, box);
            row.append(avatar, wrap);
            stream.appendChild(row);
            stream.scrollTop = stream.scrollHeight;

            return box;
        }

        function formatMarkdown(text) {
            // Escape HTML
            let escaped = text
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;");

            // Code blocks
            escaped = escaped.replace(/```([\s\S]*?)```/g, '<pre><code>$1</code></pre>');
            // Inline code
            escaped = escaped.replace(/`([^`]+)`/g, '<code>$1</code>');
            // Bold
            escaped = escaped.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
            // Line breaks
            escaped = escaped.replace(/\n/g, '<br>');

            return escaped;
        }

        async function handleChatSubmit(e) {
            e.preventDefault();
            if (isGenerating) return;

            const input = $("chatTextarea");
            const userMsg = input.value.trim();
            if (!userMsg) return;

            appendMessage("user", userMsg);
            input.value = "";
            input.style.height = "auto";

            isGenerating = true;
            $("chatSendBtn").disabled = true;

            const selectedModel = $("chatModelSelect").value;
            const responseBox = appendMessage("assistant", "Analyzing request and synthesizing response...");

            // If a custom API endpoint is defined, fetch from it
            if (CUSTOM_BACKEND_ENDPOINT) {
                try {
                    const response = await fetch(CUSTOM_BACKEND_ENDPOINT, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "Authorization": `Bearer ${currentSession ? currentSession.access_token : ''}`
                        },
                        body: JSON.stringify({ message: userMsg, model: selectedModel })
                    });
                    const data = await response.json();
                    const reply = data.reply || data.choices?.[0]?.message?.content || "Nexus AI returned an empty response.";
                    responseBox.innerHTML = formatMarkdown(reply);
                } catch (err) {
                    responseBox.innerHTML = `<span style="color:var(--danger)">Network Error: Could not reach Nexus endpoint (${err.message}). Using local synthesis below:</span><br><br>` + 
                                            formatMarkdown(generateSimulatedResponse(userMsg, selectedModel));
                }
            } else {
                // High-fidelity intelligent simulated response
                setTimeout(() => {
                    const responseText = generateSimulatedResponse(userMsg, selectedModel);
                    responseBox.innerHTML = formatMarkdown(responseText);
                    $("chatStream").scrollTop = $("chatStream").scrollHeight;
                }, 850);
            }

            requestCounter++;
            $("statsRequestCount").textContent = requestCounter;
            isGenerating = false;
            $("chatSendBtn").disabled = false;
        }

        function generateSimulatedResponse(query, model) {
            const lower = query.toLowerCase();
            const modelName = model === "nexus-ultra" ? "Nexus Ultra" : (model === "nexus-plus" ? "Nexus Plus" : "Nexus Pro");

            if (lower.includes("code") || lower.includes("typescript") || lower.includes("rate-limiting")) {
                return `**[${modelName}] TypeScript Rate-Limiter Implementation**\n\nHere is a production-grade concurrency and rate-limiting wrapper designed for high throughput:\n\n\`\`\`typescript\nclass TokenBucketRateLimiter {\n  private tokens: number;\n  private lastRefill: number;\n\n  constructor(private capacity: number, private refillRatePerSecond: number) {\n    this.tokens = capacity;\n    this.lastRefill = Date.now();\n  }\n\n  async acquire(tokens = 1): Promise<boolean> {\n    this.refill();\n    if (this.tokens >= tokens) {\n      this.tokens -= tokens;\n      return true;\n    }\n    return false;\n  }\n\n  private refill(): void {\n    const now = Date.now();\n    const elapsed = (now - this.lastRefill) / 1000;\n    this.tokens = Math.min(this.capacity, this.tokens + elapsed * this.refillRatePerSecond);\n    this.lastRefill = now;\n  }\n}\n\`\`\`\n\nThis utility guarantees thread-safe token replenishment with constant O(1) memory overhead.`;
            }

            if (lower.includes("microservices") || lower.includes("architecture")) {
                return `**[${modelName}] High-Scale Distributed Architecture**\n\n1. **API Gateway Layer**: Envoy / Kong reverse proxy terminating TLS and handling JWT verification.\n2. **State & Caching Layer**: Redis Cluster configured with cache-aside pattern for sub-millisecond hot key lookups.\n3. **Primary Persistence**: PostgreSQL instances with streaming replication to read replicas.\n4. **Event Bus**: Apache Kafka or RabbitMQ managing async command dispatching and telemetry.\n\nWould you like me to generate Docker Compose or Kubernetes manifests for this deployment?`;
            }

            if (lower.includes("email") || lower.includes("announcement") || lower.includes("launch")) {
                return `**[${modelName}] Announcement Copy: Introducing Nexus AI**\n\n**Subject**: Welcome to the Next Era of Intelligence with Nexus AI by Arnaw Studio\n\nHi everyone,\n\nWe are thrilled to unveil **Nexus AI** — our all-new cognitive intelligence platform engineered specifically for creators, engineers, and problem-solvers.\n\nFeaturing 3 distinct model architectures, enterprise-grade dark & light interfaces, and sub-second reasoning speeds, Nexus AI is ready to elevate your workflows.\n\nExplore your new workspace today.\n\nWarm regards,\n**Arnaw Studio Team**`;
            }

            return `**[${modelName}] Response**\n\nThank you for your inquiry: *"${query}"*.\n\nNexus AI has processed this request using the **${modelName}** neural pipeline. All systems are operating smoothly within the Arnaw Studio environment.\n\nTo integrate live cloud inference or custom weights, connect your backend endpoint in the Developer Platform tab or provide your private API secret.`;
        }

        $("chatForm").addEventListener("submit", handleChatSubmit);

        // Auto-expand textarea & Enter to send
        const textarea = $("chatTextarea");
        textarea.addEventListener("input", function() {
            this.style.height = "auto";
            this.style.height = (this.scrollHeight) + "px";
        });

        textarea.addEventListener("keydown", (e) => {
            if (e.key === "Enter" && !e.shiftKey) {
                e.preventDefault();
                $("chatForm").requestSubmit();
            }
        });

        /* -------------------------------------------------------------
           7. DEVELOPER PLATFORM UTILITIES
           ------------------------------------------------------------- */
        function copyCurlExample() {
            const code = $("curlSnippet").innerText;
            navigator.clipboard.writeText(code).then(() => {
                showToast("cURL example copied to clipboard!", "success");
            }).catch(() => {
                showToast("Failed to copy to clipboard", "error");
            });
        }

        /* -------------------------------------------------------------
           8. INITIALIZATION
           ------------------------------------------------------------- */
        function initApp() {
            // Apply saved or system theme
            setTheme(getPreferredTheme());

            // Initialize Supabase if keys provided
            if (isSupabaseConfigured() && window.supabase) {
                try {
                    supabase = window.supabase.createClient(SUPABASE_PROJECT_URL, SUPABASE_ANON_KEY);
                    supabase.auth.getSession().then(({ data }) => {
                        if (data && data.session) {
                            enterApplicationSession(data.session);
                        }
                    });

                    supabase.auth.onAuthStateChange((event, session) => {
                        if (event === "SIGNED_IN" && session) {
                            enterApplicationSession(session);
                        } else if (event === "SIGNED_OUT") {
                            signOutUser();
                        }
                    });
                } catch (e) {
                    console.warn("Supabase init error:", e);
                }
            }
        }

        initApp();
    </script>
