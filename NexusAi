<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#090d16">
    <title>Nexus AI — Arnaw Studio</title>
    
    <!-- Google Fonts & Supabase SDK -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

    <style>
        :root {
            --font-main: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
            --radius-sm: 8px;
            --radius-md: 12px;
            --radius-lg: 18px;
            --radius-xl: 24px;
            --transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* DARK THEME (DEFAULT) */
        [data-theme="dark"] {
            color-scheme: dark;
            --bg-base: #07090e;
            --bg-surface: #0e121a;
            --bg-surface-elevated: #141a24;
            --bg-surface-hover: #1b2332;
            --bg-input: #0a0d14;
            --border: #202838;
            --border-subtle: #161c28;
            --border-focus: #7c6cf0;
            --text-primary: #f3f6fc;
            --text-secondary: #9aa5b9;
            --text-muted: #626e82;
            --accent: #7c6cf0;
            --accent-hover: #9082fa;
            --accent-gradient: linear-gradient(135deg, #7c6cf0 0%, #a855f7 100%);
            --accent-glow: rgba(124, 108, 240, 0.25);
            --accent-subtle: rgba(124, 108, 240, 0.12);
            --success: #10b981;
            --success-subtle: rgba(16, 185, 129, 0.12);
            --warning: #f59e0b;
            --danger: #f43f5e;
            --danger-subtle: rgba(244, 63, 94, 0.12);
            --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.25);
            --shadow-md: 0 10px 30px rgba(0, 0, 0, 0.35);
            --shadow-lg: 0 20px 50px rgba(0, 0, 0, 0.5);
            --card-glass: rgba(14, 18, 26, 0.75);
            --hero-bg: radial-gradient(120% 120% at 50% 0%, #1e1842 0%, #0e121a 100%);
        }

        /* LIGHT THEME */
        [data-theme="light"] {
            color-scheme: light;
            --bg-base: #f7f9fc;
            --bg-surface: #ffffff;
            --bg-surface-elevated: #ffffff;
            --bg-surface-hover: #f1f4f9;
            --bg-input: #ffffff;
            --border: #e2e8f0;
            --border-subtle: #edf2f7;
            --border-focus: #6352e8;
            --text-primary: #0f172a;
            --text-secondary: #475569;
            --text-muted: #94a3b8;
            --accent: #6352e8;
            --accent-hover: #5041d8;
            --accent-gradient: linear-gradient(135deg, #6352e8 0%, #9333ea 100%);
            --accent-glow: rgba(99, 82, 232, 0.2);
            --accent-subtle: rgba(99, 82, 232, 0.08);
            --success: #059669;
            --success-subtle: rgba(5, 150, 105, 0.1);
            --warning: #d97706;
            --danger: #e11d48;
            --danger-subtle: rgba(225, 29, 72, 0.1);
            --shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.06);
            --shadow-md: 0 10px 25px rgba(15, 23, 42, 0.06);
            --shadow-lg: 0 20px 45px rgba(15, 23, 42, 0.1);
            --card-glass: rgba(255, 255, 255, 0.85);
            --hero-bg: linear-gradient(135deg, #f0edff 0%, #e9e4ff 50%, #fdf2f8 100%);
        }

        /* BASE RESETS */
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-base);
            color: var(--text-primary);
            font-family: var(--font-main);
            min-height: 100vh;
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
            transition: background-color 0.25s ease, color 0.25s ease;
            overflow-x: hidden;
        }

        button, input, textarea, select {
            font-family: inherit;
            color: inherit;
        }

        button {
            cursor: pointer;
            border: none;
            background: none;
            outline: none;
        }

        button:disabled {
            opacity: 0.55;
            cursor: not-allowed;
        }

        a {
            color: var(--accent);
            text-decoration: none;
        }

        .hidden { display: none !important; }

        /* ICONS UTILITY */
        .svg-icon {
            width: 18px;
            height: 18px;
            display: inline-block;
            vertical-align: middle;
            fill: currentColor;
            flex-shrink: 0;
        }

        /* -------------------------------------------
           AUTH SCREEN
        ------------------------------------------- */
        .auth-screen {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            position: relative;
            background: var(--bg-base);
        }

        .auth-screen::before {
            content: '';
            position: absolute;
            top: -20%;
            left: 50%;
            transform: translateX(-50%);
            width: 650px;
            height: 500px;
            background: radial-gradient(circle, var(--accent-glow) 0%, transparent 70%);
            filter: blur(80px);
            opacity: 0.6;
            pointer-events: none;
            z-index: 0;
        }

        .auth-top-controls {
            position: absolute;
            top: 24px;
            right: 28px;
            display: flex;
            align-items: center;
            gap: 12px;
            z-index: 10;
        }

        .auth-container {
            width: 100%;
            max-width: 440px;
            position: relative;
            z-index: 1;
            animation: fadeIn 0.4s ease-out;
        }

        .brand-header {
            text-align: center;
            margin-bottom: 28px;
        }

        .brand-logo-badge {
            width: 58px;
            height: 58px;
            margin: 0 auto 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: var(--radius-lg);
            background: var(--accent-gradient);
            color: #ffffff;
            box-shadow: 0 10px 30px var(--accent-glow);
            font-size: 28px;
            font-weight: 800;
            letter-spacing: -1px;
        }

        .brand-title {
            font-size: 26px;
            font-weight: 800;
            letter-spacing: 0.5px;
            color: var(--text-primary);
        }

        .brand-sub {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
            color: var(--text-muted);
            text-transform: uppercase;
            margin-top: 6px;
        }

        .auth-card {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-xl);
            padding: 34px 32px;
            box-shadow: var(--shadow-lg);
            backdrop-filter: blur(12px);
        }

        .auth-title {
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 6px;
            color: var(--text-primary);
        }

        .auth-subtitle {
            font-size: 13px;
            color: var(--text-secondary);
            margin-bottom: 24px;
        }

        .config-banner {
            background: var(--accent-subtle);
            border: 1px dashed var(--accent);
            border-radius: var(--radius-md);
            padding: 12px 14px;
            font-size: 12px;
            color: var(--text-secondary);
            margin-bottom: 20px;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            line-height: 1.4;
        }

        .field-group {
            margin-bottom: 18px;
        }

        .field-label {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.8px;
            color: var(--text-secondary);
            margin-bottom: 8px;
            text-transform: uppercase;
        }

        .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-control {
            width: 100%;
            padding: 13px 16px;
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            color: var(--text-primary);
            font-size: 14px;
            outline: none;
            transition: var(--transition);
        }

        .input-control:focus {
            border-color: var(--border-focus);
            box-shadow: 0 0 0 3px var(--accent-subtle);
        }

        .btn-primary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: var(--accent-gradient);
            color: #ffffff;
            font-weight: 600;
            font-size: 14px;
            padding: 13px 22px;
            border-radius: var(--radius-md);
            transition: var(--transition);
            box-shadow: 0 4px 16px var(--accent-glow);
            width: 100%;
        }

        .btn-primary:hover:not(:disabled) {
            transform: translateY(-1px);
            box-shadow: 0 8px 24px var(--accent-glow);
            filter: brightness(1.06);
        }

        .btn-secondary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: var(--bg-surface-elevated);
            color: var(--text-primary);
            border: 1px solid var(--border);
            font-weight: 600;
            font-size: 13px;
            padding: 11px 18px;
            border-radius: var(--radius-md);
            transition: var(--transition);
            width: 100%;
        }

        .btn-secondary:hover {
            background: var(--bg-surface-hover);
            border-color: var(--text-muted);
        }

        .divider {
            display: flex;
            align-items: center;
            text-align: center;
            margin: 20px 0;
            color: var(--text-muted);
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .divider::before, .divider::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid var(--border);
        }

        .divider::before { margin-right: 12px; }
        .divider::after { margin-left: 12px; }

        .auth-feedback {
            margin-top: 14px;
            padding: 10px 14px;
            border-radius: var(--radius-sm);
            font-size: 12px;
            display: none;
            line-height: 1.5;
        }

        .auth-feedback.error {
            display: block;
            background: var(--danger-subtle);
            border: 1px solid var(--danger);
            color: var(--danger);
        }

        .auth-feedback.success {
            display: block;
            background: var(--success-subtle);
            border: 1px solid var(--success);
            color: var(--success);
        }

        .auth-toggle-link {
            text-align: center;
            margin-top: 22px;
            font-size: 13px;
            color: var(--text-secondary);
        }

        .auth-toggle-link button {
            color: var(--accent);
            font-weight: 600;
            margin-left: 4px;
            text-decoration: underline;
            text-underline-offset: 3px;
        }

        .auth-footer {
            text-align: center;
            font-size: 11px;
            color: var(--text-muted);
            margin-top: 26px;
        }

        /* -------------------------------------------
           APPLICATION LAYOUT
        ------------------------------------------- */
        #application {
            display: none;
            min-height: 100vh;
        }

        /* SIDEBAR */
        .app-sidebar {
            width: 260px;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            background: var(--bg-surface);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            z-index: 100;
            padding: 24px 16px;
            transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 4px 8px 24px;
            border-bottom: 1px solid var(--border-subtle);
            margin-bottom: 20px;
        }

        .sidebar-logo {
            width: 38px;
            height: 38px;
            border-radius: var(--radius-md);
            background: var(--accent-gradient);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 19px;
            box-shadow: 0 4px 12px var(--accent-glow);
        }

        .sidebar-brand-text h2 {
            font-size: 16px;
            font-weight: 800;
            letter-spacing: 0.5px;
            line-height: 1.2;
        }

        .sidebar-brand-text span {
            font-size: 10px;
            color: var(--text-muted);
            letter-spacing: 1.5px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .nav-section-title {
            font-size: 10px;
            font-weight: 700;
            color: var(--text-muted);
            letter-spacing: 1.5px;
            text-transform: uppercase;
            padding: 8px 12px;
            margin-top: 10px;
        }

        .nav-list {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            width: 100%;
            padding: 10px 14px;
            border-radius: var(--radius-md);
            color: var(--text-secondary);
            font-size: 13.5px;
            font-weight: 500;
            transition: var(--transition);
        }

        .nav-link:hover {
            background: var(--bg-surface-hover);
            color: var(--text-primary);
        }

        .nav-link.active {
            background: var(--accent-subtle);
            color: var(--accent);
            font-weight: 600;
        }

        .nav-link svg {
            stroke: currentColor;
            width: 18px;
            height: 18px;
            stroke-width: 2;
            fill: none;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .sidebar-footer {
            margin-top: auto;
            border-top: 1px solid var(--border-subtle);
            padding-top: 16px;
        }

        .user-profile-widget {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 8px;
            border-radius: var(--radius-md);
            background: var(--bg-surface-elevated);
            border: 1px solid var(--border);
        }

        .user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--accent-gradient);
            color: #ffffff;
            font-weight: 700;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .user-meta {
            flex: 1;
            min-width: 0;
        }

        .user-meta-name {
            font-size: 13px;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            color: var(--text-primary);
        }

        .user-meta-tier {
            font-size: 11px;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .badge-live {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--success);
        }

        .icon-btn-ghost {
            color: var(--text-muted);
            padding: 6px;
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
        }

        .icon-btn-ghost:hover {
            color: var(--danger);
            background: var(--danger-subtle);
        }

        /* TOPBAR */
        .app-main {
            margin-left: 260px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .app-topbar {
            height: 70px;
            padding: 0 32px;
            background: var(--bg-surface);
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 50;
            display: flex;
            align-items: center;
            justify-content: space-between;
            backdrop-filter: blur(10px);
        }

        .topbar-left {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .mobile-toggle {
            display: none;
            color: var(--text-primary);
            padding: 6px;
            border-radius: var(--radius-sm);
        }

        .breadcrumb-trail {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: var(--text-muted);
        }

        .breadcrumb-trail span.active {
            color: var(--text-primary);
            font-weight: 600;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .system-badge {
            font-size: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            border-radius: 30px;
            background: var(--success-subtle);
            color: var(--success);
            font-weight: 600;
            border: 1px solid rgba(16, 185, 129, 0.2);
        }

        .theme-toggle-btn {
            width: 40px;
            height: 40px;
            border-radius: var(--radius-md);
            border: 1px solid var(--border);
            background: var(--bg-surface-elevated);
            color: var(--text-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
        }

        .theme-toggle-btn:hover {
            border-color: var(--accent);
            color: var(--accent);
            transform: rotate(15deg);
        }

        /* -------------------------------------------
           MAIN PAGES CONTENT
        ------------------------------------------- */
        .content-container {
            max-width: 1320px;
            width: 100%;
            margin: 0 auto;
            padding: 36px 32px 60px;
            flex: 1;
        }

        .page-view {
            display: none;
            animation: fadeIn 0.25s ease-out;
        }

        .page-view.active {
            display: block;
        }

        .page-header {
            margin-bottom: 28px;
        }

        .page-header h1 {
            font-size: 28px;
            font-weight: 800;
            letter-spacing: -0.5px;
            color: var(--text-primary);
        }

        .page-header p {
            color: var(--text-secondary);
            font-size: 14px;
            margin-top: 4px;
        }

        /* HERO CARD (OVERVIEW) */
        .hero-banner {
            border: 1px solid var(--border);
            background: var(--hero-bg);
            border-radius: var(--radius-xl);
            padding: 38px 42px;
            position: relative;
            overflow: hidden;
            margin-bottom: 30px;
            box-shadow: var(--shadow-md);
        }

        [data-theme="dark"] .hero-banner {
            border-color: rgba(124, 108, 240, 0.35);
        }

        .hero-banner-content {
            position: relative;
            z-index: 2;
            max-width: 620px;
        }

        .hero-tag {
            display: inline-block;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--accent);
            background: var(--accent-subtle);
            padding: 4px 10px;
            border-radius: 20px;
            margin-bottom: 14px;
            border: 1px solid var(--accent-glow);
        }

        .hero-banner h2 {
            font-size: 30px;
            font-weight: 800;
            line-height: 1.25;
            color: var(--text-primary);
            margin-bottom: 12px;
        }

        .hero-banner p {
            font-size: 14px;
            color: var(--text-secondary);
            line-height: 1.6;
            margin-bottom: 24px;
        }

        .hero-actions {
            display: flex;
            gap: 14px;
            flex-wrap: wrap;
        }

        .hero-bg-art {
            position: absolute;
            right: 30px;
            bottom: -30px;
            font-size: 220px;
            font-weight: 900;
            color: var(--accent);
            opacity: 0.05;
            line-height: 1;
            user-select: none;
            pointer-events: none;
        }

        /* STATS GRID */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 20px;
            margin-bottom: 34px;
        }

        .stat-card {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 22px 24px;
            box-shadow: var(--shadow-sm);
            transition: var(--transition);
        }

        .stat-card:hover {
            border-color: var(--accent);
            transform: translateY(-2px);
        }

        .stat-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            color: var(--text-muted);
            font-size: 13px;
            font-weight: 600;
        }

        .stat-icon-wrap {
            width: 36px;
            height: 36px;
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--accent-subtle);
            color: var(--accent);
        }

        .stat-value {
            font-size: 30px;
            font-weight: 800;
            color: var(--text-primary);
            margin: 14px 0 4px;
            letter-spacing: -0.5px;
        }

        .stat-caption {
            font-size: 12px;
            color: var(--text-secondary);
        }

        /* MODEL CARDS */
        .section-title {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 18px;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .model-cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 22px;
        }

        .model-card-item {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 26px;
            transition: var(--transition);
            display: flex;
            flex-direction: column;
            position: relative;
        }

        .model-card-item:hover {
            border-color: var(--accent);
            box-shadow: var(--shadow-md);
            transform: translateY(-3px);
        }

        .model-header-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
        }

        .model-icon-box {
            width: 44px;
            height: 44px;
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--accent-subtle);
            color: var(--accent);
        }

        .badge-status {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.8px;
            padding: 4px 9px;
            border-radius: 20px;
            background: var(--bg-surface-hover);
            color: var(--text-muted);
            border: 1px solid var(--border);
        }

        .badge-status.active {
            background: var(--success-subtle);
            color: var(--success);
            border-color: rgba(16, 185, 129, 0.3);
        }

        .model-card-item h3 {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .model-card-item p {
            font-size: 13px;
            color: var(--text-secondary);
            line-height: 1.6;
            margin-bottom: 20px;
            flex: 1;
        }

        .model-specs-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
            padding-top: 16px;
            border-top: 1px solid var(--border-subtle);
            font-size: 12px;
            color: var(--text-muted);
        }

        .model-spec-row {
            display: flex;
            justify-content: space-between;
        }

        .model-spec-row span:last-child {
            color: var(--text-primary);
            font-weight: 600;
        }

        /* -------------------------------------------
           AI WORKSPACE (CHAT)
        ------------------------------------------- */
        .chat-wrapper {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-xl);
            display: flex;
            flex-direction: column;
            height: calc(100vh - 200px);
            min-height: 580px;
            box-shadow: var(--shadow-md);
            overflow: hidden;
        }

        .chat-header-bar {
            height: 64px;
            padding: 0 24px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: var(--bg-surface);
        }

        .chat-model-selector {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .chat-select {
            padding: 8px 14px;
            border-radius: var(--radius-md);
            background: var(--bg-surface-elevated);
            color: var(--text-primary);
            border: 1px solid var(--border);
            font-size: 13px;
            font-weight: 600;
            outline: none;
            cursor: pointer;
            transition: var(--transition);
        }

        .chat-select:focus {
            border-color: var(--accent);
        }

        .chat-stream-area {
            flex: 1;
            overflow-y: auto;
            padding: 30px;
            display: flex;
            flex-direction: column;
            gap: 24px;
            scroll-behavior: smooth;
        }

        .empty-chat-state {
            margin: auto;
            text-align: center;
            max-width: 480px;
            padding: 40px 20px;
        }

        .empty-state-icon {
            width: 68px;
            height: 68px;
            border-radius: var(--radius-xl);
            background: var(--accent-subtle);
            color: var(--accent);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            box-shadow: 0 10px 25px var(--accent-glow);
        }

        .empty-chat-state h2 {
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .empty-chat-state p {
            font-size: 13.5px;
            color: var(--text-secondary);
            margin-bottom: 24px;
        }

        .prompt-chips-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            text-align: left;
        }

        .prompt-chip {
            padding: 12px 14px;
            background: var(--bg-surface-elevated);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            font-size: 12px;
            color: var(--text-secondary);
            transition: var(--transition);
            line-height: 1.4;
        }

        .prompt-chip strong {
            display: block;
            color: var(--text-primary);
            font-size: 12.5px;
            margin-bottom: 2px;
        }

        .prompt-chip:hover {
            border-color: var(--accent);
            color: var(--text-primary);
            background: var(--bg-surface-hover);
        }

        .chat-bubble-row {
            display: flex;
            gap: 14px;
            align-items: flex-start;
            max-width: 900px;
            width: 100%;
        }

        .chat-bubble-row.user {
            margin-left: auto;
            flex-direction: row-reverse;
        }

        .bubble-avatar {
            width: 34px;
            height: 34px;
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 13px;
            flex-shrink: 0;
        }

        .chat-bubble-row.assistant .bubble-avatar {
            background: var(--accent-gradient);
            color: #ffffff;
        }

        .chat-bubble-row.user .bubble-avatar {
            background: var(--bg-surface-elevated);
            color: var(--text-primary);
            border: 1px solid var(--border);
        }

        .bubble-content-wrap {
            display: flex;
            flex-direction: column;
            gap: 4px;
            max-width: 82%;
        }

        .bubble-author-name {
            font-size: 11px;
            font-weight: 700;
            color: var(--text-muted);
            letter-spacing: 0.5px;
        }

        .chat-bubble-row.user .bubble-author-name {
            text-align: right;
        }

        .bubble-message-box {
            padding: 14px 18px;
            border-radius: var(--radius-lg);
            font-size: 13.5px;
            line-height: 1.7;
            word-break: break-word;
        }

        .chat-bubble-row.assistant .bubble-message-box {
            background: var(--bg-surface-elevated);
            color: var(--text-primary);
            border: 1px solid var(--border);
            border-top-left-radius: 4px;
        }

        .chat-bubble-row.user .bubble-message-box {
            background: var(--accent);
            color: #ffffff;
            border-top-right-radius: 4px;
        }

        .bubble-message-box pre {
            background: var(--bg-base);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            padding: 12px;
            margin: 10px 0;
            overflow-x: auto;
            font-family: var(--font-mono);
            font-size: 12px;
        }

        .bubble-message-box code {
            font-family: var(--font-mono);
            font-size: 12px;
            padding: 2px 6px;
            border-radius: 4px;
            background: rgba(0, 0, 0, 0.15);
        }

        .chat-composer-panel {
            padding: 16px 20px;
            border-top: 1px solid var(--border);
            background: var(--bg-surface);
        }

        .composer-input-row {
            display: flex;
            gap: 12px;
            align-items: flex-end;
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 8px 12px;
            transition: var(--transition);
        }

        .composer-input-row:focus-within {
            border-color: var(--border-focus);
            box-shadow: 0 0 0 3px var(--accent-subtle);
        }

        .composer-textarea {
            flex: 1;
            border: none;
            background: transparent;
            color: var(--text-primary);
            font-size: 14px;
            resize: none;
            max-height: 140px;
            min-height: 44px;
            padding: 10px 4px;
            outline: none;
            line-height: 1.5;
        }

        .btn-send {
            width: 44px;
            height: 44px;
            border-radius: var(--radius-md);
            background: var(--accent);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
            flex-shrink: 0;
        }

        .btn-send:hover:not(:disabled) {
            background: var(--accent-hover);
            transform: scale(1.05);
        }

        /* -------------------------------------------
           DEVELOPER PLATFORM
        ------------------------------------------- */
        .api-panel-card {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 28px;
            margin-bottom: 24px;
        }

        .api-row-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 0;
            border-bottom: 1px solid var(--border-subtle);
        }

        .api-row-item:last-child {
            border-bottom: none;
        }

        .api-code-block {
            background: var(--bg-base);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            padding: 16px;
            font-family: var(--font-mono);
            font-size: 12.5px;
            color: var(--text-secondary);
            overflow-x: auto;
            position: relative;
            margin-top: 14px;
        }

        .copy-code-btn {
            position: absolute;
            top: 12px;
            right: 12px;
            font-size: 11px;
            padding: 6px 10px;
            border-radius: var(--radius-sm);
            background: var(--bg-surface-elevated);
            color: var(--text-secondary);
            border: 1px solid var(--border);
        }

        /* -------------------------------------------
           SETTINGS
        ------------------------------------------- */
        .settings-grid {
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .settings-card {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 28px;
        }

        .settings-card h3 {
            font-size: 17px;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .settings-card p.desc {
            font-size: 13px;
            color: var(--text-secondary);
            margin-bottom: 20px;
        }

        .setting-field {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 0;
            border-bottom: 1px solid var(--border-subtle);
        }

        .setting-field:last-child {
            border-bottom: none;
        }

        .setting-label-title {
            font-size: 13.5px;
            font-weight: 600;
            color: var(--text-primary);
        }

        .setting-label-desc {
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 2px;
        }

        .theme-select-pills {
            display: flex;
            gap: 8px;
            background: var(--bg-surface-elevated);
            padding: 4px;
            border-radius: var(--radius-md);
            border: 1px solid var(--border);
        }

        .theme-pill-btn {
            padding: 6px 14px;
            font-size: 12px;
            font-weight: 600;
            border-radius: var(--radius-sm);
            color: var(--text-secondary);
            transition: var(--transition);
        }

        .theme-pill-btn.active {
            background: var(--accent);
            color: #ffffff;
            box-shadow: var(--shadow-sm);
        }

        /* TOAST NOTIFICATION */
        .toast-popup {
            position: fixed;
            bottom: 28px;
            right: 28px;
            padding: 14px 20px;
            background: var(--bg-surface-elevated);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            color: var(--text-primary);
            font-size: 13px;
            font-weight: 500;
            box-shadow: var(--shadow-lg);
            z-index: 1000;
            display: flex;
            align-items: center;
            gap: 10px;
            opacity: 0;
            transform: translateY(20px);
            transition: var(--transition);
            pointer-events: none;
        }

        .toast-popup.visible {
            opacity: 1;
            transform: translateY(0);
            pointer-events: auto;
        }

        .toast-popup.success {
            border-left: 4px solid var(--success);
        }

        .toast-popup.error {
            border-left: 4px solid var(--danger);
        }

        .toast-popup.info {
            border-left: 4px solid var(--accent);
        }

        /* MOBILE OVERLAY */
        .sidebar-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(4px);
            z-index: 90;
        }

        /* ANIMATIONS */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* RESPONSIVE */
        @media (max-width: 900px) {
            .app-sidebar {
                transform: translateX(-100%);
            }

            .app-sidebar.open {
                transform: translateX(0);
                box-shadow: var(--shadow-lg);
            }

            .sidebar-backdrop.open {
                display: block;
            }

            .app-main {
                margin-left: 0;
            }

            .mobile-toggle {
                display: block;
            }

            .content-container {
                padding: 24px 18px 40px;
            }

            .prompt-chips-grid {
                grid-template-columns: 1fr;
            }

            .hero-bg-art {
                display: none;
            }

            .system-badge {
                display: none;
            }
        }
    </style>
</head>
